{
  "name": "sacrament-meetings",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node db/check-migrations.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "migrate": "node --env-file=.env.local db/migrate.mjs",
    "migrate:prod": "node --env-file=.env.prod-db db/migrate.mjs",
    "backup": "node --env-file=.env.prod-db db/backup.mjs",
    "import:heads": "node --env-file=.env.local db/import-heads.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "^3.0.3",
    "next": "16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^10.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "use-debounce": "^10.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "resolutions": {
    "source-map-js": "^1.2.2",
    "undici": "^6.29.1",
    "zod": "^4.6.7",
    "baseline-browser-mapping": "^2.11.0"
  }
}
